\par \pard\plain \s81\sl240\slmult1\widctlpar\sb80\sa120\ltrpar\cbpat23\hyphpar0\kerning0\cf0\rtlch\af14\afs22\alang1025\ltrch\hich\af10\afs18\alang1033\ai0\ab0\dbch\af12\langfe1033\loch\f10\fs18\lang1033\i0\b0{
Input: prefill instance pool P, decoding instance pool D, request R, cache block size B.\line Output: the prefill and decoding instances (p, d) to process R.\line  1: block_keys \u8592\'3f PrefixHash(R.prompt_tokens, B)\line  2: TTFT \u8592\'3f inf\line  3: p \u8592\'3f \u8709\'3f\line  4: best_prefix_len, best_matched_instance \u8592\'3f FindBestPrefixMatch(P, block_keys)\line  5: for instance \u8712\'3f P do\line  6:     prefix_len \u8592\'3f instance.prefix_len\line  7:     Tqueue \u8592\'3f EstimatePrefillQueueTime(instance)\line  8:     if best_prefix_len < kvcache_balancing_threshold then            \u9655\'3f Cache-aware prefill scheduling\line             prefix_len\line  9:        Tprefill \u8592\'3f EstimatePrefillExecutionTime(len(R.prompt_tokens), prefix_len)\line 10:        if TTFT > Tqueue + Tprefill then\line 11:            TTFT \u8592\'3f Tqueue + Tprefill\line 12:            p \u8592\'3f instance\line 13:        end if\line 14:     else                                              \u9655\'3f Cache-aware and -balancing prefill scheduling\line 15:        transfer_len \u8592\'3f best_prefix_len - prefix_len\line 16:        Ttransfer \u8592\'3f EstimateKVCacheTransferTime(instance, best_matched_instance, transfer_len)\line 17:        Tprefill \u8592\'3f EstimatePrefillExecutionTime(len(R.prompt_tokens), best_prefix_len)\line 18:        if TTFT > Ttransfer + Tqueue + Tprefill then\line 19:            TTFT \u8592\'3f Ttransfer + Tqueue + Tprefill\line 20:            p \u8592\'3f instance\line 21:        end if\line 22:     end if\line 23: end for\line 24: d, TBT \u8592\'3f SelectDecodingInstance(D)                             \u9655\'3f Load-balancing decoding scheduling\line 25: if TTFT > TTFT_SLO or TBT > TBT_SLO then\line 26:     reject R; return\line 27: end if\line 28: if best_prefix_len > kvcache_balancing_threshold then\line         p.prefix_len\line 29:     TransferKVCache(best_matched_instance, p)                          \u9655\'3f KVCache hot-spot migration\line 30: end if\line 31: return (p, d)}
