{
  "name": "MinerU - download and extract a result ZIP",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "manual",
      "name": "Run workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "parameters": {}
    },
    {
      "id": "download",
      "name": "Download result ZIP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://example.com/replace-with-result-url.zip",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "unzip",
      "name": "Extract result ZIP",
      "type": "n8n-nodes-base.compression",
      "typeVersion": 1,
      "position": [
        740,
        300
      ],
      "parameters": {
        "operation": "decompress",
        "binaryPropertyName": "data",
        "outputPrefix": "result_"
      }
    }
  ],
  "connections": {
    "Run workflow": {
      "main": [
        [
          {
            "node": "Download result ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download result ZIP": {
      "main": [
        [
          {
            "node": "Extract result ZIP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "tags": []
}
